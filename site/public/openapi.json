{
  "openapi":"3.1.0",
  "info":{"title":"MGA-resource · mainly-for-agent","version":"1.0.0","description":"Free medical drawing components. Candidates require task-specific image inspection. Each original retains its own license."},
  "servers":[{"url":"https://mga-resource-mainly-for-agent.pages.dev"}],
  "paths":{
    "/v1/search":{
      "get":{"operationId":"searchComponents","summary":"Search with a short query","parameters":[{"name":"q","in":"query","required":true,"schema":{"type":"string","maxLength":512}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":20,"default":10}},{"name":"cursor","in":"query","schema":{"type":"string"}}],"responses":{"200":{"$ref":"#/components/responses/SearchResults"},"400":{"description":"Invalid request or cursor"},"503":{"description":"Temporary service or free-quota failure. Retry later."}}},
      "post":{"operationId":"searchStructuredComponents","summary":"Search with science, appearance, project and adoption constraints","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchRequest"}}}},"responses":{"200":{"$ref":"#/components/responses/SearchResults"},"400":{"description":"Invalid request, fields or cursor"},"503":{"description":"Temporary service or free-quota failure; not an empty result"}}}
    },
    "/v1/assets/{id}":{"get":{"operationId":"getFamilyMetadata","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"string"}}],"responses":{"307":{"description":"Redirect to public family JSON including exact originals, provenance and download URLs"},"404":{"description":"Unknown or unpublished asset"}}}},
    "/version.json":{"get":{"operationId":"getCatalogVersion","responses":{"200":{"description":"Catalog version and distinct current/historical acceptance scores"}}}},
    "/v1/health":{"get":{"operationId":"getServiceHealth","responses":{"200":{"description":"Catalog/index/core bindings match"},"503":{"description":"Database unavailable or version mismatch"}}}}
  },
  "components":{
    "schemas":{
      "SearchRequest":{"type":"object","required":["query"],"additionalProperties":false,"properties":{
        "query":{"type":"string","minLength":1,"maxLength":512},"limit":{"type":"integer","minimum":1,"maximum":20,"default":10},
        "filters":{"type":"object","description":"Hard filters: source/license/category/format/structure/content_type/species/state/view/role/object/depiction_kind/color_mode/palette_traits/representation/detail/realism/series/transparent/asset_id/family_id/file_sha256. Unknown does not satisfy a constraint."},
        "mode":{"type":"string","enum":["explore","design","exact"],"default":"explore"},"seed":{"type":"string","maxLength":256},"preferences":{"type":"object"},
        "project":{"type":"object","description":"Project style and selected file pins"},"history":{"type":"object","description":"Explicit final adoption only; adopted entries carry status=adopted"},"cursor":{"type":"string"},"candidate_pool":{"type":"integer","minimum":50,"maximum":100}
      }},
      "SearchPage":{"type":"object","required":["results","next_cursor","query_plan","diagnostics"],"properties":{
        "results":{"type":"array","items":{"type":"object","required":["asset_id","selected_file","selected_source","preview","download","metadata_url"],"properties":{"asset_id":{"type":"string"},"selected_file":{"type":"object"},"selected_source":{"type":"object","description":"Includes source identity and exact provenance/attribution/license"},"preview":{"type":"object","properties":{"url":{"type":"string","format":"uri"},"sha256":{"type":"string"}}},"download":{"type":"object","properties":{"url":{"type":"string","format":"uri"},"sha256":{"type":"string"},"size_bytes":{"type":"integer"},"format":{"type":"string"}}},"metadata_url":{"type":"string","format":"uri"},"text_content":{"type":"object"}}}},
        "next_cursor":{"type":["string","null"]},"query_plan":{"type":"object"},"diagnostics":{"type":"object"},"bindings":{"type":"object"},"service":{"type":"object"}
      }}
    },
    "responses":{"SearchResults":{"description":"Actual selected variants with direct hosted file URLs. Empty results are genuine no-match results, not service errors.","content":{"application/json":{"schema":{"$ref":"#/components/schemas/SearchPage"}}}}}
  }
}
